{
  "manifest_version": 3,
  "name": "PrimeFaces Inspector",
  "version": "0.4.0",
  "description": "Inspect PrimeFaces widgets: list, search, filter, Client API, events and Ajax monitoring.",
  "permissions": ["activeTab", "storage", "scripting"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PrimeFaces Inspector"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["dist/inject/pageScript.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
